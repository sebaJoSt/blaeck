  "timestamp_mode": "micros",
  "signals": [
    {"name": "Value", "type": "int", "value": 1},
    {"name": "Level", "type": "float", "value": 0.0, "write_at_interval": "off", "write_on_change": 1.0, "min_interval_ms": 300}
  ],
  "steps": [

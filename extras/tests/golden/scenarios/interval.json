    {"command": "<BLAECK.INTERVAL_START,1e3>"},
    {"command": "<BLAECK.INTERVAL_START,4294967296>"},
    {"advance_ms": 250},
    {"command": "<BLAECK.INTERVAL_START,4294967295>"},
    {"advance_ms": 250}
  ]
}

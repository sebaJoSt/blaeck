    {"command": "<BLAECK.DATA_START>"},
    {"command": "<BLAECK.INTERVAL_START,1000>"},
    {"advance_ms": 999},
    {"advance_ms": 501},
    {"advance_ms": 600},
    {"advance_ms": 899},
    {"advance_ms": 1},
    {"advance_ms": 2500},
    {"advance_ms": 400},
    {"set_signal": "Level", "value": 5.0},
    {"set_signal": "Level", "value": 10.0},
    {"advance_ms": 299},
    {"advance_ms": 1},
    {"set_signal": "Level", "value": 10.5},
    {"advance_ms": 300},
    {"command": "<BLAECK.INTERVAL_START,0>"},
    {"tick": true},
    {"advance_ms": 1},
    {"command": "<BLAECK.INTERVAL_START,250>"},
    {"advance_ms": 249},
    {"advance_ms": 1},
    {"command": "<BLAECK.INTERVAL_START>"},
    {"command": "<BLAECK.INTERVAL_START,>"},
    {"command": "<BLAECK.INTERVAL_START,abc>"},
    {"command": "<BLAECK.INTERVAL_START,+1000>"},
